# Copy to .env (never commit .env). One .env per environment (local / production).

APP_ENV=local            # local | production
APP_DEBUG=true           # false in production
APP_KEY=change-me-to-a-long-random-string   # php tools/funnel.php key  -> generates one

# ---- Mail -------------------------------------------------------------
# MAIL_DRIVER: log (writes to storage/logs, for local dev) | smtp | mail (PHP mail())
MAIL_DRIVER=log
MAIL_FROM=no-reply@yourcompany.nl
MAIL_TO=leads@yourcompany.nl          # comma-separated; used by the "mailbox" integration
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=tls                       # tls | ssl | none

# ---- Integrations (only needed when enabled for a form) ---------------
WEBHOOK_URL=
WEBHOOK_SECRET=

HUBSPOT_PORTAL_ID=
HUBSPOT_FORM_GUID=
HUBSPOT_TOKEN=                        # optional private-app token -> uses the secure submit endpoint

BLINQX_ENDPOINT=
BLINQX_TOKEN=
