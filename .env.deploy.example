# Copy to .env.deploy (never commit). Used by tools/deploy.sh.
# Values come from the IT partner (see docs/it-partner-request.md).

SFTP_HOST=sftp.hostingpartner.nl
SFTP_PORT=22
SFTP_USER=
SFTP_PASS=                 # or leave empty and use SFTP_KEY
SFTP_KEY=                  # path to private key, e.g. ~/.ssh/id_ed25519
SFTP_REMOTE_DIR=/domains/example.yourcompany.nl   # folder that CONTAINS public/
